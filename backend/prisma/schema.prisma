// =============================================================================
// SasyaVahini — Prisma Schema
// Database: PostgreSQL
// Owner: Member 1 (Backend Core & Data)
//
// WORKFLOW CONTRACT (preserved as invariants in code):
//   BuyerRequirement → AllocationProposal → explicit Farmer/FPO CONSENT
//   → authoritative inventory validation → atomic Reservation
//   → shortfall-only rematching after rejection/unavailability
//   → Order fulfilment → DeliveryRecord verification → Settlement/Payment
//
// INVARIANTS:
//   1. A proposal is NOT a reservation (different models).
//   2. A forecast is NOT a confirmed order.
//   3. Inventory cannot be double-reserved (reservedQty + freeQty = totalQty).
//   4. Existing accepted/reserved quantities must not be silently reassigned.
//   5. Order state changes validated server-side only.
//   6. Users must not access another role's resources without permission.
//   7. Payment release tied to verified delivery workflow.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  FARMER
  FPO
  BUYER
  LOGISTICS
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum QualityGrade {
  GRADE_A
  GRADE_B
  GRADE_C
  ORGANIC_PREMIUM
}

enum ListingStatus {
  AVAILABLE      // Fully available, no reservations
  PARTIALLY_RESERVED // Part of the quantity is reserved
  RESERVED       // Fully reserved — do not match further
  SOLD           // Order fulfilled and settled
  EXPIRED        // Past harvest date / withdrawn by farmer
}

enum ProposalStatus {
  PENDING        // Sent to farmer/FPO, awaiting consent
  ACCEPTED       // Farmer/FPO explicitly accepted — triggers Reservation
  REJECTED       // Farmer/FPO rejected — triggers shortfall rematching
  CANCELLED      // Cancelled by system before farmer responded
  EXPIRED        // Farmer did not respond within deadline
}

enum OrderStatus {
  // State machine — transitions validated server-side (Member 1)
  PLACED         // Buyer requirement matched and order created
  MATCHED        // Allocation proposals accepted, reservations made
  RESERVED       // All inventory atomically reserved
  CONFIRMED      // Confirmed by all parties
  PICKED_UP      // Logistics confirmed all pickup stops
  IN_TRANSIT     // Vehicle en route to delivery location
  DELIVERED      // Logistics marked delivered (unverified)
  DELIVERY_VERIFIED // Buyer + OTP/photo proof confirmed
  SETTLED        // Payment released to farmers/FPOs
  CANCELLED      // Order cancelled (before RESERVED)
  DISPUTED       // Dispute raised — held for admin
}

enum RequirementStatus {
  OPEN           // Accepting supplier matches
  MATCHING       // System is running matching algorithm
  PARTIALLY_MATCHED
  FULLY_MATCHED  // All quantity allocated and accepted
  FULFILLED      // Order settled end-to-end
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  ESCROW_HELD    // Buyer paid, held in escrow
  RELEASED       // Released to farmers/FPOs after delivery verification
  REFUNDED       // Refunded to buyer (dispute/cancellation)
  DISPUTED
}

enum NotificationType {
  INFO
  ORDER_UPDATE
  PROPOSAL
  PAYMENT
  ALERT
  SYSTEM
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  MAINTENANCE
}

enum DeliveryProofType {
  OTP
  PHOTO
  BOTH
}

enum AuditAction {
  USER_REGISTERED
  USER_APPROVED
  USER_SUSPENDED
  LISTING_CREATED
  LISTING_UPDATED
  REQUIREMENT_POSTED
  PROPOSAL_CREATED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  RESERVATION_CREATED
  RESERVATION_RELEASED
  ORDER_STATUS_CHANGED
  DELIVERY_VERIFIED
  PAYMENT_RELEASED
  ADMIN_ACTION
  LOT_CREATED
  LOT_UPDATED
  LOT_STATUS_CHANGED
  LOT_CANCELLED
  QUOTATION_CREATED
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  QUOTATION_EXPIRED
  QUOTATION_WITHDRAWN
  SETTLEMENT_GENERATED
  SETTLEMENT_PAYMENT_RECORDED
  SETTLEMENT_DISPUTED
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum LotStatus {
  DRAFT
  AGGREGATED
  TESTED
  READY_FOR_SALE
  ALLOCATED
  FULFILLED
  CANCELLED
}

// =============================================================================
// AUTHENTICATION
// =============================================================================

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  phone            String      @unique
  passwordHash     String
  googleId         String?     @unique
  avatarUrl        String?
  name             String
  role             Role
  status           UserStatus  @default(PENDING_VERIFICATION)
  isEmailVerified  Boolean     @default(false)
  isPhoneVerified  Boolean     @default(false)
  preferredLocale  String      @default("en") // "en" | "hi" | "mr"
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Profiles (exactly one for the given role)
  farmerProfile    FarmerProfile?
  fpoProfile       FPOProfile?
  buyerProfile     BuyerProfile?
  logisticsProfile LogisticsProfile?
  adminProfile     AdminProfile?

  // Auth
  refreshTokens    RefreshToken[]
  otpCodes         OtpCode[]

  // Activity
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique  // Store bcrypt hash, never plaintext
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model OtpCode {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier  String?   // email or phone number for targeted lookups and rate limiting
  code        String    // Store hashed (SHA256 or bcrypt)
  purpose     String    // "LOGIN" | "PHONE_VERIFY" | "EMAIL_VERIFY" | "PASSWORD_RESET"
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([identifier])
  @@index([purpose])
}

// =============================================================================
// ROLE PROFILES
// =============================================================================

model FarmerProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // FPO membership (optional)
  fpoId           String?
  fpo             FPOProfile? @relation(fields: [fpoId], references: [id])

  // Farm details
  landSizeAcres   Float     @default(1.0)
  produceTypes    String[]  // e.g. ["Tomato", "Onion"]
  state           String
  district        String
  village         String?
  latitude        Float?
  longitude       Float?

  // Verification documents
  aadhaarVerified Boolean   @default(false)
  bankAccountVerified Boolean @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  listings        ProduceListing[]
  allocations     AllocationItem[]
  lotContributions ProduceLotContribution[]
  settlements     FarmerSettlement[]

  @@index([fpoId])
  @@index([district])
}

model FPOProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  fpoName          String
  registrationNo   String    @unique
  memberCount      Int       @default(0)
  state            String
  district         String
  address          String?
  latitude         Float?
  longitude        Float?

  registrationCertVerified Boolean @default(false)
  commissionRatePercent    Float   @default(0)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members          FarmerProfile[]
  listings         ProduceListing[]
  allocations      AllocationItem[]
  produceLots      ProduceLot[]
  quotations       FpoQuotation[]
  settlements      FarmerSettlement[]

  @@index([district])
}

model BuyerProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationName String
  buyerType        String    // "Individual" | "Wholesaler" | "Supermarket" | "Hotel" | "Restaurant" | "Retailer" | "Government"
  gstNumber        String?
  deliveryState    String?
  deliveryDistrict String?
  deliveryAddress  String?
  latitude         Float?
  longitude        Float?

  // Phase 2: Business details & verification
  verificationStatus String   @default("NOT_SUBMITTED") // "NOT_SUBMITTED" | "PENDING" | "VERIFIED" | "REJECTED" | "ADDITIONAL_INFORMATION_REQUIRED"
  verificationNotes  String?
  businessCategory   String?
  contactPerson      String?

  // Phase 2: Dedicated Billing Address
  billingAddress     String?
  billingState       String?
  billingDistrict    String?
  billingPincode     String?
  billingGstin       String?

  // Phase 2: Preferences
  notificationPreferences Json?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  requirements     BuyerRequirement[]
  orders           Order[]
  payments         Payment[]
  addresses        BuyerAddress[]
  cart             Cart?

  @@index([buyerType])
  @@index([verificationStatus])
}

model BuyerAddress {
  id                   String       @id @default(uuid())
  buyerId              String
  buyer                BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  recipientName        String
  contactNumber        String
  addressType          String       @default("HOME") // "HOME" | "BUSINESS" | "BILLING" | "OTHER"
  addressLine1         String
  addressLine2         String?
  locality             String?
  city                 String
  state                String
  postalCode           String
  country              String       @default("India")
  deliveryInstructions String?
  isDefault            Boolean      @default(false)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([buyerId])
  @@index([isDefault])
}

// =============================================================================
// BUYER SHOPPING CART (Phase 5)
// =============================================================================

model Cart {
  id        String       @id @default(uuid())
  buyerId   String       @unique
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([buyerId])
}

model CartItem {
  id         String         @id @default(uuid())
  cartId     String
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listingId  String
  listing    ProduceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantityKg Float
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([cartId, listingId])
  @@index([cartId])
  @@index([listingId])
}

model LogisticsProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Transport Partner Sub-Role: "DRIVER" | "VEHICLE_OWNER" | "FLEET_OPERATOR"
  partnerType      String    @default("VEHICLE_OWNER")
  companyName      String
  licenseNo        String?
  serviceStates    String[]
  serviceDistricts String[]

  // Individual Driver / Owner Personal Attributes
  ownerName        String?
  dob              DateTime?
  emergencyContact String?
  profilePhotoUrl  String?

  // Driving Licence Verification Details
  drivingLicenceNo String?
  licenceExpiry    DateTime?
  permittedClasses String[]  @default([])
  licenceFrontUrl  String?
  licenceBackUrl   String?
  driverVerified   Boolean   @default(false)

  // Fleet Operator / Business Credentials
  panNumber        String?
  gstin            String?
  businessRegNo    String?
  businessCertUrl  String?
  ownershipType    String?   @default("Individual") // "Individual" | "Partnership" | "Private Ltd"

  // Payout & Banking Details
  accountHolderName String?
  bankName         String?
  accountNumber    String?
  ifscCode         String?

  // Verification Audit & Status
  licenseVerified  Boolean   @default(false)
  verificationStatus String  @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"
  adminRemarks     String?
  rejectionReason  String?
  verifiedAt       DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehicles         Vehicle[]
  deliveries       DeliveryRecord[]

  @@index([licenseNo])
  @@index([partnerType])
  @@index([verificationStatus])
}

model AdminProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  department       String    @default("DoCA")
  designation      String?

  createdAt        DateTime  @default(now())
}

// =============================================================================
// PRODUCE & INVENTORY
// =============================================================================

model ProduceListing {
  id               String        @id @default(uuid())
  farmerId         String
  farmer           FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  // Optional FPO aggregation context
  fpoId            String?
  fpo              FPOProfile?   @relation(fields: [fpoId], references: [id])

  // Product info
  cropName         String
  category         String        // "Vegetables" | "Fruits" | "Grains" | "Pulses" | "Spices"
  qualityGrade     QualityGrade  @default(GRADE_A)
  isOrganic        Boolean       @default(false)

  // Quantity tracking — INVARIANT: reservedQty <= totalQuantityKg
  totalQuantityKg  Float
  reservedQty      Float         @default(0)  // atomically updated on Reservation
  soldQty          Float         @default(0)

  askingPricePerKg Float
  minPricePerKg    Float

  harvestDate      DateTime
  expiryDate       DateTime?

  // Location
  state            String
  district         String
  village          String?
  pickupAddress    String?
  pincode          String?
  latitude         Float?
  longitude        Float?
  locationAccuracy String?       @default("GPS_PIN")

  imageUrl         String?
  description      String?

  status           ListingStatus @default(AVAILABLE)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  allocationItems  AllocationItem[]
  lotContributions ProduceLotContribution[]
  cartItems        CartItem[]

  @@index([cropName])
  @@index([status])
  @@index([district])
  @@index([harvestDate])
  @@index([farmerId])
}

// =============================================================================
// BUYER REQUIREMENTS
// =============================================================================

model BuyerRequirement {
  id               String            @id @default(uuid())
  buyerId          String
  buyer            BuyerProfile      @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  cropName         String
  quantityKg       Float
  maxPricePerKg    Float
  requiredByDate   DateTime
  qualityGrade     QualityGrade?

  deliveryState    String
  deliveryDistrict String
  deliveryAddress  String?
  latitude         Float?
  longitude        Float?

  notes            String?

  status           RequirementStatus @default(OPEN)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  proposals        AllocationProposal[]
  order            Order?
  quotations       FpoQuotation[]

  @@index([cropName])
  @@index([status])
  @@index([buyerId])
  @@index([requiredByDate])
}

// =============================================================================
// ALLOCATION — PROPOSAL → CONSENT → RESERVATION
// =============================================================================

// An AllocationProposal is created by the matching engine.
// It is NOT a reservation. Inventory is not decremented until
// the farmer/FPO explicitly ACCEPTS and the system creates a Reservation.
model AllocationProposal {
  id              String            @id @default(uuid())
  requirementId   String
  requirement     BuyerRequirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  // Aggregated set of supplier assignments
  totalAllocatedKg Float
  matchScore       Float             // 0–100 composite score

  status           ProposalStatus   @default(PENDING)
  consentDeadline  DateTime          // After this, status → EXPIRED

  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items            AllocationItem[]
  reservation      Reservation?
  fpoQuotation     FpoQuotation?

  @@index([requirementId])
  @@index([status])
}

// Each item in a proposal targets one farmer/FPO's listing.
model AllocationItem {
  id               String             @id @default(uuid())
  proposalId       String
  proposal         AllocationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  listingId        String
  listing          ProduceListing     @relation(fields: [listingId], references: [id])

  farmerId         String?
  farmer           FarmerProfile?     @relation(fields: [farmerId], references: [id])
  fpoId            String?
  fpo              FPOProfile?        @relation(fields: [fpoId], references: [id])

  allocatedQtyKg   Float
  proposedPricePerKg Float

  // Consent tracking per item
  status           ProposalStatus     @default(PENDING)
  consentAt        DateTime?
  rejectionReason  String?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([proposalId])
  @@index([listingId])
  @@index([farmerId])
  @@index([fpoId])
}

// A Reservation is created ONLY after ACCEPTED proposals.
// Atomic: all-or-nothing within a database transaction.
// INVARIANT: A listing's reservedQty never exceeds totalQuantityKg.
model Reservation {
  id               String             @id @default(uuid())
  proposalId       String             @unique
  proposal         AllocationProposal @relation(fields: [proposalId], references: [id])
  orderId          String?            @unique
  order            Order?             @relation(fields: [orderId], references: [id])

  totalReservedKg  Float
  expiresAt        DateTime?          // Reservations expire if order not confirmed

  releasedAt       DateTime?          // Set when reservation is released (rejection/cancellation)
  createdAt        DateTime           @default(now())

  @@index([proposalId])
}

// =============================================================================
// ORDERS
// =============================================================================

model Order {
  id               String        @id @default(uuid())
  buyerId          String
  buyer            BuyerProfile  @relation(fields: [buyerId], references: [id])
  requirementId    String        @unique
  requirement      BuyerRequirement @relation(fields: [requirementId], references: [id])
  reservation      Reservation?

  orderNumber      String        @unique // human-readable e.g. SV-2026-00001

  totalQuantityKg  Float
  agreedPriceTotal Float

  status           OrderStatus   @default(PLACED)

  deliveryAddress  String
  deliveryLatitude Float?
  deliveryLongitude Float?
  scheduledDelivery DateTime?
  actualDelivery   DateTime?

  notes            String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  statusHistory    OrderStatusEvent[]
  delivery         DeliveryRecord?
  payment          Payment?
  notifications    Notification[]
  fpoQuotation     FpoQuotation?
  farmerSettlements FarmerSettlement[]

  @@index([buyerId])
  @@index([status])
  @@index([orderNumber])
}

// Immutable log of every status transition.
model OrderStatusEvent {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedBy   String      // userId of actor
  reason      String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

// =============================================================================
// LOGISTICS
// =============================================================================

model Vehicle {
  id               String           @id @default(uuid())
  logisticsId      String
  logistics        LogisticsProfile @relation(fields: [logisticsId], references: [id], onDelete: Cascade)

  vehicleNumber    String           @unique
  vehicleType      String           // "Truck" | "Mini-Truck" | "Tempo" | "Refrigerated"
  capacityKg       Float
  driverName       String
  driverPhone      String

  // Professional Vehicle Specifications
  make             String?          // e.g. Tata, Mahindra, Ashok Leyland, Eicher
  model            String?          // e.g. Intra V30, Ace Gold, Bolero Maxi Truck, 407 Gold
  manufacturingYear Int?            // e.g. 2022
  category         String           @default("MCV") // "SCV" | "MCV" | "HCV"
  fuelType         String           @default("DIESEL") // "DIESEL" | "PETROL" | "CNG" | "ELECTRIC"
  gvwKg            Float?           // Gross vehicle weight
  mileageKmpl      Float?           // Fuel efficiency in km/L
  dimensions       String?          // e.g. "14ft x 6ft x 6ft"
  isRefrigerated   Boolean          @default(false)
  minTempC         Float?
  maxTempC         Float?
  baseHub          String?          // Base depot / city
  operatingDistricts String[]       @default([])
  photoUrls        String[]         @default([])

  status           VehicleStatus    @default(AVAILABLE)
  currentLatitude  Float?
  currentLongitude Float?
  lastLocationAt   DateTime?

  // Document verification statuses
  rcVerified        Boolean         @default(false)
  insuranceVerified Boolean         @default(false)
  fitnessVerified   Boolean         @default(false)
  permitVerified    Boolean         @default(false)
  pucVerified       Boolean         @default(false)
  taxVerified       Boolean         @default(false)

  verificationStatus String         @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"
  rejectionReason   String?
  adminRemarks      String?
  verifiedAt        DateTime?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  documents        VehicleDocument[]
  deliveries       DeliveryRecord[]

  @@index([status])
  @@index([logisticsId])
  @@index([verificationStatus])
  @@index([category])
}

model VehicleDocument {
  id                 String    @id @default(uuid())
  vehicleId          String
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  docType            String    // "RC" | "INSURANCE" | "FITNESS" | "PERMIT" | "PUC" | "ROAD_TAX"
  docNumber          String?
  fileUrl            String    // URL or Base64/Data URL
  frontUrl           String?
  backUrl            String?
  issueDate          DateTime?
  expiryDate         DateTime?

  verificationStatus String    @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"
  adminRemarks       String?
  rejectionReason    String?
  verifiedAt         DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([vehicleId])
  @@index([docType])
  @@index([verificationStatus])
}

model DeliveryRecord {
  id                String           @id @default(uuid())
  orderId           String           @unique
  order             Order            @relation(fields: [orderId], references: [id])

  vehicleId         String?
  vehicle           Vehicle?         @relation(fields: [vehicleId], references: [id])
  logisticsId       String?
  logistics         LogisticsProfile? @relation(fields: [logisticsId], references: [id])

  // OR-Tools CVRP result (stored as JSON)
  routeJson         Json?            // Waypoints, distances, ETA from logistics service
  totalDistanceKm   Float?
  estimatedMinutes  Int?
  estimatedFuelCost Float?

  // Pickup tracking
  pickedUpAt        DateTime?
  pickedUpProof     String?

  // Delivery tracking
  deliveredAt       DateTime?
  proofType         DeliveryProofType?
  proofValue        String?          // OTP or photo URL
  verifiedAt        DateTime?        // Set when buyer confirms
  verifiedBy        String?          // userId of verifier

  // GPS tracking (stored as JSON array of {lat, lng, ts})
  gpsTrackJson      Json?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([orderId])
  @@index([vehicleId])
}

// =============================================================================
// PAYMENTS & SETTLEMENT
// =============================================================================

// INVARIANT: Payment is released only after delivery is verified.
model Payment {
  id               String        @id @default(uuid())
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id])
  buyerId          String
  buyer            BuyerProfile  @relation(fields: [buyerId], references: [id])

  totalAmount      Float
  platformFee      Float         @default(0)
  taxAmount        Float         @default(0)
  netFarmerPayout  Float

  status           PaymentStatus @default(ESCROW_HELD)

  // External provider (Member 3 — test mode initially)
  providerName     String?       // "Razorpay" | "Stripe" | "MOCK"
  providerRef      String?       // External transaction ID

  paidAt           DateTime?
  releasedAt       DateTime?     // Set only after delivery verified
  refundedAt       DateTime?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id])
  proposalId  String?
  metadata    Json?

  type        NotificationType @default(INFO)
  title       String
  body        String
  isRead      Boolean          @default(false)
  readAt      DateTime?

  // Delivery channels (Member 3)
  sentViaSms    Boolean   @default(false)
  sentViaEmail  Boolean   @default(false)
  sentViaWhatsapp Boolean @default(false)

  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  action      AuditAction
  entityType  String      // "User" | "Order" | "Reservation" etc.
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// =============================================================================
// ML DEMAND FORECAST (cached results from ML service — Member 5)
// =============================================================================

model DemandForecast {
  id                 String    @id @default(uuid())
  cropName           String
  district           String
  state              String
  predictedDemandKg  Float
  currentSupplyKg    Float
  demandGapKg        Float
  demandLevel        String    // "HIGH" | "MEDIUM" | "LOW"
  recommendedPricePerKg Float?
  confidenceScore    Float?
  explainabilityJson Json?     // Factors from FastAPI ML service
  forecastPeriodStart DateTime
  forecastPeriodEnd   DateTime
  modelVersion       String?
  createdAt          DateTime  @default(now())

  @@index([cropName, district])
  @@index([forecastPeriodStart])
}


// =============================================================================
// ===== M4 LOGISTICS (Member 4) ===============================================
// =============================================================================

enum ShipmentStatus {
  UNASSIGNED
  ASSIGNED
  PICKUP
  TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum StopType {
  PICKUP
  DELIVERY
}

enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
  SKIPPED
}

enum LogisticsLegType {
  FEEDER
  LINEHAUL
  LASTMILE
  DIRECT
}

enum LogisticsOfferStatus {
  PENDING
  ACCEPTED
  EXPIRED
  DECLINED
  CANCELLED
}

model Shipment {
  id                  String                  @id @default(uuid())
  trackingNumber      String                  @unique
  orderId             String                  @unique
  vehicleId           String?
  logisticsId         String?

  status              ShipmentStatus          @default(UNASSIGNED)
  deliveryOtp         String?                 // 6-digit OTP for delivery verification

  totalWeightKg       Float
  totalDistanceKm     Float?
  baselineDistanceKm  Float?
  savedDistanceKm     Float?
  estimatedFuelSavedRs Float?
  utilizationPercent  Float?
  estimatedMinutes    Int?

  routeGeometryJson   Json?                   // GeoJSON LineString coordinates
  costBreakdownJson   Json?                   // Auditable TLC ledger

  scheduledPickupAt   DateTime?
  deliveredAt         DateTime?

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  stops               ShipmentStop[]
  milestoneHistory    ShipmentMilestoneEvent[]
  locationPings       LocationPing[]
  legs                ShipmentLeg[]
  transferEvents      TransferEvent[]

  @@index([orderId])
  @@index([vehicleId])
  @@index([status])
  @@index([trackingNumber])
}

// M4 planning and execution persistence. Vehicle remains intentionally
// unchanged; vehicleClass links these records to the existing fleet.
model VehicleSpec {
  id               String   @id @default(uuid())
  vehicleClass     String   @unique
  capacityKg       Float
  minRoadClass     String
  baseFare         Float    @default(0)
  perKmRate        Float    @default(0)
  avgSpeedKmh      Float    @default(40)
  serviceRadiusKm  Float    @default(100)
  heavyVehicle     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TransferPoint {
  id              String   @id @default(uuid())
  name            String
  latitude        Float
  longitude       Float
  roadAccess      String
  capacityKg      Float
  handlingFeePerKg Float   @default(0)
  openHours       String?
  zone            String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  legs            ShipmentLeg[]
  transferEvents  TransferEvent[]

  @@index([roadAccess])
  @@index([isActive])
}

model PlanQuote {
  id              String   @id @default(uuid())
  quoteId         String   @unique
  crop            String
  requestedQtyKg  Float
  maxBudget       Float?
  radiusUsedKm    Float?
  ringsTried      Json
  payload         Json
  explanation     String
  expiresAt       DateTime
  confirmedAt     DateTime?
  priceLocked     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  legs            ShipmentLeg[]
  offers          LogisticsOffer[]

  @@index([expiresAt])
}

model ShipmentLeg {
  id               String          @id @default(uuid())
  shipmentId       String?
  shipment         Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  planQuoteId      String?
  planQuote        PlanQuote?       @relation(fields: [planQuoteId], references: [id], onDelete: Cascade)
  transferPointId  String?
  transferPoint    TransferPoint?   @relation(fields: [transferPointId], references: [id])
  sequence         Int
  type             LogisticsLegType
  vehicleClass     String
  fromJson         Json
  toJson           Json
  km               Float
  etaMin           Int
  cost             Float
  kg               Float
  status           String          @default("PLANNED")
  routeOptionsJson Json?
  selectedRouteIndex Int?
  routeLockedAt    DateTime?
  plannedCostRs    Float?
  plannedFuelLitres Float?
  plannedEtaMin    Int?
  legPayoutRs      Float?
  deviationReason  String?
  actualCostRs     Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  offers           LogisticsOffer[]

  @@index([shipmentId])
  @@index([planQuoteId])
  @@index([transferPointId])
  @@index([status])
}

model LogisticsOffer {
  id            String               @id @default(uuid())
  planQuoteId   String?
  planQuote     PlanQuote?           @relation(fields: [planQuoteId], references: [id], onDelete: Cascade)
  shipmentLegId String?
  shipmentLeg   ShipmentLeg?         @relation(fields: [shipmentLegId], references: [id], onDelete: Cascade)
  vehicleId     String
  status        LogisticsOfferStatus  @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([shipmentLegId, status])
  @@index([vehicleId, status])
  @@index([expiresAt])
}

model TransferEvent {
  id              String         @id @default(uuid())
  shipmentId      String?
  shipment        Shipment?      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  transferPointId String
  transferPoint   TransferPoint  @relation(fields: [transferPointId], references: [id])
  feederDriverId  String?
  linehaulDriverId String?
  feederKg        Float
  linehaulKg      Float
  toleranceKg     Float
  status          String
  disputeReason   String?
  feederConfirmedAt DateTime?
  linehaulConfirmedAt DateTime?
  createdAt       DateTime       @default(now())

  @@index([shipmentId])
  @@index([transferPointId])
  @@index([status])
}

model RoadAccessCache {
  id          String   @id @default(uuid())
  cacheKey    String   @unique
  latitude    Float
  longitude   Float
  roadClass   String
  source      String   @default("OSM")
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model ShipmentStop {
  id           String      @id @default(uuid())
  shipmentId   String
  shipment     Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  stopType     StopType    @default(PICKUP)
  sequence     Int
  farmerId     String?
  listingId    String?
  stopName     String
  address      String?
  latitude     Float
  longitude    Float
  quantityKg   Float

  status       StopStatus  @default(PENDING)
  arrivalEta   DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  proofNotes   String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([shipmentId])
  @@index([sequence])
}

model ShipmentMilestoneEvent {
  id           String         @id @default(uuid())
  shipmentId   String
  shipment     Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status       ShipmentStatus
  milestone    String
  latitude     Float?
  longitude    Float?
  temperatureC Float?
  notes        String?
  recordedBy   String?        // userId

  recordedAt   DateTime       @default(now())

  @@index([shipmentId])
  @@index([status])
}

model LocationPing {
  id           String      @id @default(uuid())
  vehicleId    String?
  shipmentId   String?
  shipment     Shipment?   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  latitude     Float
  longitude    Float
  speedKmh     Float?
  temperatureC Float?      // Cold-chain monitoring
  recordedAt   DateTime    @default(now())

  @@index([vehicleId])
  @@index([shipmentId])
  @@index([recordedAt])
}

// =============================================================================
// FPO CONSOLIDATED PRODUCE LOTS (PHASE 4)
// =============================================================================

model ProduceLot {
  id                    String                   @id @default(uuid())
  lotNumber             String                   @unique
  fpoId                 String
  fpo                   FPOProfile               @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  cropName              String
  category              String                   @default("Vegetables")
  variety               String?
  qualityGrade          QualityGrade             @default(GRADE_A)
  unit                  String                   @default("kg")
  totalQuantityKg       Float
  availableQuantityKg   Float
  allocatedQuantityKg   Float                    @default(0)
  weightedAvgPricePerKg Float
  status                LotStatus                @default(AGGREGATED)
  notes                 String?
  storageLocation       String?
  harvestDate           DateTime?
  expiryDate            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  contributions         ProduceLotContribution[]
  quotations            FpoQuotation[]

  @@index([fpoId])
  @@index([cropName])
  @@index([status])
  @@index([lotNumber])
}

model ProduceLotContribution {
  id               String         @id @default(uuid())
  lotId            String
  lot              ProduceLot     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  notificationId   String?        // Ref to accepted contribution notification
  listingId        String
  listing          ProduceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  farmerId         String
  farmer           FarmerProfile  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  allocatedQtyKg   Float
  agreedPricePerKg Float
  status           String         @default("COMMITTED") // "COMMITTED" | "RELEASED"
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  settlements      FarmerSettlement[]

  @@index([lotId])
  @@index([listingId])
  @@index([farmerId])
  @@index([notificationId])
}

// =============================================================================
// FPO BULK QUOTATIONS (PHASE 5)
// =============================================================================

model FpoQuotation {
  id                    String              @id @default(uuid())
  quotationNumber       String              @unique
  requirementId         String
  requirement           BuyerRequirement    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  fpoId                 String
  fpo                   FPOProfile          @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  produceLotId          String?
  produceLot            ProduceLot?         @relation(fields: [produceLotId], references: [id], onDelete: SetNull)
  orderId               String?             @unique
  order                 Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  proposalId            String?             @unique
  proposal              AllocationProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  offeredQuantityKg     Float
  offeredPricePerKg     Float
  totalAmount           Float
  estimatedDeliveryDate DateTime
  validityDate          DateTime
  notes                 String?
  status                QuotationStatus     @default(PENDING)

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([requirementId])
  @@index([fpoId])
  @@index([produceLotId])
  @@index([status])
  @@index([quotationNumber])
}

// =============================================================================
// FPO FARMER SETTLEMENTS & PAYMENTS (PHASE 7)
// =============================================================================

enum SettlementStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  DISPUTED
  CANCELLED
}

enum SettlementPaymentMode {
  BANK_TRANSFER
  NEFT
  RTGS
  UPI
  CHEQUE
  CASH
}

model FarmerSettlement {
  id                    String                   @id @default(uuid())
  settlementNumber      String                   @unique
  orderId               String
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fpoId                 String
  fpo                   FPOProfile               @relation(fields: [fpoId], references: [id], onDelete: Cascade)
  farmerId              String
  farmer                FarmerProfile            @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  contributionId        String?
  contribution          ProduceLotContribution?  @relation(fields: [contributionId], references: [id], onDelete: SetNull)

  cropName              String
  variety               String?
  quantityKg            Float
  agreedPricePerKg      Float
  grossAmount           Float                    // quantityKg * agreedPricePerKg

  commissionRatePercent Float                    @default(0) // Explicitly configured only (do not invent)
  commissionAmount      Float                    @default(0) // grossAmount * (commissionRatePercent / 100)
  logisticsFeeShare     Float                    @default(0) // Optional logistics deduction when available

  netPayable            Float                    // grossAmount - commissionAmount - logisticsFeeShare
  paidAmount            Float                    @default(0)
  outstandingAmount     Float                    // netPayable - paidAmount

  status                SettlementStatus         @default(PENDING)
  dueDate               DateTime?
  settledAt             DateTime?
  notes                 String?

  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  payments              SettlementPaymentRecord[]

  @@unique([orderId, farmerId]) // Invariant: Exactly one settlement record per farmer per order
  @@index([orderId])
  @@index([fpoId])
  @@index([farmerId])
  @@index([status])
  @@index([settlementNumber])
}

model SettlementPaymentRecord {
  id               String                @id @default(uuid())
  settlementId     String
  settlement       FarmerSettlement      @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  amount           Float
  paymentMode      SettlementPaymentMode @default(BANK_TRANSFER)
  transactionRef   String                // patriotic / UTR / Bank transaction ref
  paymentDate      DateTime              @default(now())
  recordedBy       String                // FPO user ID
  receiptUrl       String?
  notes            String?

  createdAt        DateTime              @default(now())

  @@index([settlementId])
  @@index([transactionRef])
}

// =============================================================================
// TRANSACTIONAL OUTBOX (TASK 12)
// =============================================================================

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String    // "SHIPMENT" | "VEHICLE" | "LEG" | "OFFER"
  aggregateId   String
  eventType     String    // "shipment.created", "shipment.milestone", "shipment.delivered", etc.
  payload       Json
  status        String    @default("PENDING") // "PENDING" | "PROCESSING" | "SENT" | "FAILED"
  retryCount    Int       @default(0)
  maxRetries    Int       @default(5)
  lastError     String?
  scheduledFor  DateTime  @default(now())
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
}
