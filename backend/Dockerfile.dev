# ──────────────────────────────────────────────────────────────────────────────
# SasyaVahini Backend — Development Dockerfile
# Uses nodemon for hot-reload with volume-mounted source code
# ──────────────────────────────────────────────────────────────────────────────
FROM node:18-alpine

# Install OpenSSL (required by Prisma on Alpine)
RUN apk add --no-cache openssl

WORKDIR /app

# Install nodemon globally for dev hot-reload
RUN npm install -g nodemon

# Copy package files for dependency caching
COPY backend/package.json ./backend/
COPY package.json package-lock.json ./

# Install all dependencies (including devDependencies for dev mode)
RUN npm install --workspace=backend

# Copy prisma schema for client generation
COPY backend/prisma ./backend/prisma

# Generate Prisma client with the correct binary target
RUN cd backend && npx prisma generate

# Source code is volume-mounted in dev mode, but copy as fallback
COPY backend/src ./backend/src

EXPOSE 5000

# Start with nodemon for hot-reload
CMD ["npm", "run", "dev", "--workspace=backend"]
