# ──────────────────────────────────────────────────────────────────────────────
# SasyaVahini Frontend — Development Dockerfile
# Uses Vite dev server with HMR for live updates
# ──────────────────────────────────────────────────────────────────────────────
FROM node:18-alpine

WORKDIR /app

# Copy package files for dependency caching
COPY frontend/package.json ./frontend/
COPY package.json package-lock.json ./

# Install all dependencies (including devDependencies)
RUN npm install --workspace=frontend

# Source code is volume-mounted in dev mode, but copy as fallback
COPY frontend/ ./frontend/

EXPOSE 5173

# Vite dev server — bind to 0.0.0.0 so it's accessible from host
CMD ["npx", "--workspace=frontend", "vite", "--host", "0.0.0.0", "--port", "5173"]
