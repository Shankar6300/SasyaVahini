# ──────────────────────────────────────────────────────────────────────────────
# SasyaVahini — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Node / Express ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── PostgreSQL (Prisma) ───────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=sasyavahini
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/sasyavahini?schema=public"
DIRECT_URL="postgresql://postgres:yourpassword@localhost:5432/sasyavahini?schema=public"

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_LONG_RANDOM_REFRESH_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── OTP (development-only stub — no real SMS sent when ENABLE_REAL_OTP=false) ─
ENABLE_REAL_OTP=false
OTP_EXPIRY_SECONDS=300

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Client ID from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# ── Transactional Email (SMTP / Nodemailer) ───────────────────────────────────
# Works with Gmail App Passwords, SendGrid SMTP, Amazon SES, Brevo, or Mailtrap
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@sasyavahini.in"
SMTP_PASS="your-smtp-app-password"
EMAIL_FROM="SasyaVahini Notifications <notifications@sasyavahini.in>"
APP_URL="http://localhost:3000"

# ── SMS / WhatsApp Gateway (Twilio or Fast2SMS) ────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""
FAST2SMS_API_KEY=""
# ── ML Service (FastAPI) ─────────────────────────────────────────────────────
ML_SERVICE_URL="http://127.0.0.1:8000"
ML_SERVICE_TIMEOUT_MS=5000

# ── Logistics and Routing Service ────────────────────────────────────────────
LOGISTICS_SERVICE_URL="http://127.0.0.1:8001"
ROUTING_SERVICE_URL="http://127.0.0.1:8001"
OSRM_URL="https://router.project-osrm.org"
LOGISTICS_DATA_SOURCE="mock"

# ── Frontend (Vite — public env vars must be prefixed VITE_) ─────────────────
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_APP_NAME="SasyaVahini"
