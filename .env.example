# ──────────────────────────────────────────────────────────────────────────────
# SasyaVahini — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Node / Express ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── PostgreSQL (Prisma) ───────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/sasyavahini?schema=public"

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_LONG_RANDOM_REFRESH_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── OTP (development-only stub — no real SMS sent when ENABLE_REAL_OTP=false) ─
ENABLE_REAL_OTP=false
OTP_EXPIRY_SECONDS=300

# ── Optional: Twilio (SMS/WhatsApp — Member 3) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Optional: SendGrid (email — Member 3) ─────────────────────────────────────
SENDGRID_API_KEY=

# ── ML Service (FastAPI — Member 5) ──────────────────────────────────────────
ML_SERVICE_URL="http://127.0.0.1:8000"
ML_SERVICE_TIMEOUT_MS=5000

# ── Logistics service (Python/OR-Tools — Member 4) ───────────────────────────
LOGISTICS_SERVICE_URL="http://127.0.0.1:8001"

# ── Frontend (Vite — public env vars must be prefixed VITE_) ─────────────────
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_APP_NAME="SasyaVahini"
